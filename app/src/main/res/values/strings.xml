    <string name="about_body">TMS Measurement helps clinicians locate the F3 site on the head for transcranial magnetic stimulation (TMS), using the Beam F3 method. You enter three head measurements, and the app calculates the distances X, Y and adjusted Y. It saves them for each client, with a log of treatment sessions, for follow-up visits. It is a calculation aid: clinical use of the results is your responsibility.</string>
    <string name="about_privacy">The app collects no data, and nothing you enter leaves your device.</string>
    <string name="about_version">Version %1$s (%2$d)</string>
    <!-- About screen, cocode-apps standard. Translations follow in the Danish PR. -->
    <string name="about_check_updates" tools:ignore="MissingTranslation">See the latest version</string>
    <string name="about_updates_note" tools:ignore="MissingTranslation">Opens the page with the latest version in your browser. The app never checks for updates by itself.</string>
    <string name="about_what_title" tools:ignore="MissingTranslation">What the app does</string>
    <string name="about_privacy_title" tools:ignore="MissingTranslation">Privacy</string>
    <string name="about_privacy_permissions" tools:ignore="MissingTranslation">The app asks for no permissions, not even internet access. It has no analytics, ads, tracking or cookies.</string>
    <string name="about_privacy_backup" tools:ignore="MissingTranslation">If you use Android backup, your phone may include the saved data in your own backup. That is your choice, and we cannot see it.</string>
    <string name="about_privacy_link" tools:ignore="MissingTranslation">Read the privacy policy</string>
    <string name="about_links_title" tools:ignore="MissingTranslation">Links</string>
    <string name="about_links_note" tools:ignore="MissingTranslation">These buttons open pages in your browser. The app itself stays offline.</string>
    <string name="about_website" tools:ignore="MissingTranslation">Open the website</string>
    <string name="about_source" tools:ignore="MissingTranslation">See the source code on GitHub</string>
    <string name="about_report" tools:ignore="MissingTranslation">Report a problem on GitHub</string>
    <string name="about_credits" tools:ignore="MissingTranslation">Credits and licenses</string>
    <string name="about_credits_body" tools:ignore="MissingTranslation">TMS Measurement is open source: its code is public, and you may use it under the MIT license. It is built with AndroidX libraries, including Jetpack Compose and Room, which use the Apache License 2.0.</string>
